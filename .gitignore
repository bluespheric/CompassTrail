# Compass Trail — .gitignore
# Depo herkese açık olabilir. Sırlar ASLA commit edilmez.
# Yanlışlıkla commit edilen bir sır dosyayı silmekle güvenli olmaz: anahtarı iptal et (rotate) ve yenile.

# --- Sırlar ve ortam dosyaları ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
supabase/.env
supabase/.env.*
!supabase/.env.example

# --- Supabase yerel çalışma dosyaları ---
supabase/.temp/
supabase/.branches/
supabase/.vscode/

# --- Gerçek kullanıcı verisi / yüklenen belgeler (asla depoya girmez) ---
uploads/
user-data/
*.dump
*.backup
backups/

# --- Bağımlılıklar ve derleme çıktıları ---
node_modules/
dist/
build/
.cache/
.parcel-cache/
.vite/
.next/
.output/
*.tsbuildinfo
*.tgz

# --- Günlükler ve test çıktıları ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# --- Paket yöneticisi önbellekleri ---
.npm
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# --- Linter önbellekleri ---
.eslintcache
.stylelintcache

# --- Editör ve işletim sistemi ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
